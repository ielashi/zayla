# Enrichment: the Provider (endpoint, model and key) is chosen in the web UI,
# under Settings, and stored in the library. Nothing here configures it.

# Where the Library lives (default ./library; /data in the Docker image).
# LIBRARY_DIR=./library

# The port the server listens on (default 3000).
# PORT=3000

# --- Passkeys ---
# The address the BROWSER opens Zayla at: an origin, with no path. Behind a
# reverse proxy that's the public HTTPS address, not the local server. Without
# it, passkeys aren't offered and you sign in with a password. Passkeys work on
# HTTPS, or on http://localhost.
#
# Production example:
#   ZAYLA_URL=https://docs.example.com
#
# Local development:
#   ZAYLA_URL=http://localhost:3000
#
# The name shown in the passkey prompt (default Zayla).
# RP_NAME=Zayla
